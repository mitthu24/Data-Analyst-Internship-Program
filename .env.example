# ── Database (required) ──────────────────────────────────────────────
# PostgreSQL connection string (Railway in production, local Postgres in
# development). Example shape only — replace with a real connection string.
# See docs/DATABASE.md for setup and migration instructions.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ── Site ──────────────────────────────────────────────────────────────
# Public site URL (used for metadata, Open Graph, and absolute links).
NEXT_PUBLIC_SITE_URL="https://example.com"

# ── Founder account bootstrap (required once, server-only) ─────────────
# Used only by `npm run db:seed` to create the first founder account. The
# email intentionally has no default — set the real one here. Never commit
# real values. The account is forced to change this password on first
# login; see docs/SECURITY.md.
FOUNDER_BOOTSTRAP_EMAIL=""
FOUNDER_BOOTSTRAP_PASSWORD=""

# ── Google Sheets lead sync (optional — disabled until all three are set) ──
# See docs/GOOGLE_SHEETS_SETUP.md for the exact setup steps. Until these are
# set, leads are stored correctly in Postgres and marked sheetsSyncStatus=DISABLED.
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_SHEETS_SHEET_NAME="Leads"

# ── Image uploads (optional — falls back to manual image URLs until set) ──
# A Vercel Blob store's read/write token. Create one in the Vercel dashboard
# (Storage → Blob) and paste the token here. See docs/DEPLOYMENT.md.
BLOB_READ_WRITE_TOKEN=""
